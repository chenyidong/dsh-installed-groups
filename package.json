{
  "name": "dsh-installed-groups",
  "version": "0.1.3",
  "type": "module",
  "description": "DSH 已安装插件原位分类视图：自动归类 + 手动调整 + 搜索 + 一键缩放，插件简介自动译成中文并持久缓存。",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "plugin-manager",
    "categories",
    "ui"
  ],
  "license": "MIT",
  "author": "chenyidong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenyidong/dsh-installed-groups.git"
  },
  "homepage": "https://github.com/chenyidong/dsh-installed-groups#readme",
  "bugs": {
    "url": "https://github.com/chenyidong/dsh-installed-groups/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "translations.json",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "displayName": "已安装插件分类视图",
    "description": "已安装插件自动分类、手动调整、搜索、一键缩放，英文简介自动译成中文并持久缓存。",
    "icon": "./icon.svg"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
